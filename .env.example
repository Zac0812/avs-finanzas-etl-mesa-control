# .env.example
#
# Plantilla de variables de entorno necesarias para correr el proyecto.
# Copia este archivo como ".env" (sin ".example") en la raíz del proyecto
# y reemplaza cada valor por las credenciales reales.
#
# IMPORTANTE: el archivo ".env" real NUNCA debe subirse a git (ver .gitignore).
# Pide las credenciales reales al responsable del proyecto / administrador de BD.

# --- SQL Server CGestion (Destino: base de datos donde se escriben las tablas de MesaControl) ---
SQL_USER_CGestion="usuario_sql"
SQL_PASS_CGestion="password_sql"
SQL_SERVER_CGestion="nombre_del_servidor"
SQL_DB_CGestion="CGestion"

# --- NetSuite (Oracle ODBC) ---
# Requiere tener instalado el driver ODBC "NetSuite Drivers 64bit" en el equipo.
ORACLE_USER="usuario@dominio.com"
ORACLE_PASS="password_netsuite"
ORACLE_HOST="xxxxxxx.connect.api.netsuite.com"
ORACLE_PORT="1708"
ORACLE_ROLE_ID="0000"

# --- Google Sheets / Drive (Service Account) ---
# Ruta al archivo JSON de la cuenta de servicio (ver carpeta credentials/).
PATH_CREDS_DRIVE="C:/ruta/al/proyecto/credentials/credsDrive.json"

# --- Infor (SQL Server, Trusted_Connection=yes -> no requiere usuario/password) ---
INFOR_SERVER="nombre_del_servidor_infor"
INFOR_DB="nombre_de_la_bd_infor"

# --- SICAF / Flota (SQL Server, Trusted_Connection=yes -> no requiere usuario/password) ---
SICAF_SERVER="nombre_del_servidor_sicaf"
SICAF_DB="nombre_de_la_bd_flota"
